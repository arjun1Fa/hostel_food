PROJECT_NAME="Hostel Food Management"
API_V1_STR="/api/v1"

# Database: SQLite for local dev or PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./hostel_food.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/hostel_food"

# JWT & Security
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Timezone & Reminders
TIMEZONE="Asia/Kolkata"
REMINDER_FIRST_HOUR=20
REMINDER_FIRST_MINUTE=0
REMINDER_FINAL_HOUR=22
REMINDER_FINAL_MINUTE=0

# Default Single Hostel (Phase 1)
DEFAULT_HOSTEL_NAME="Heritage Boys & Girls Hostel"
DEFAULT_HOSTEL_CODE="HERITAGE-01"

# Admin Bootstrap
ADMIN_EMAIL="admin@hostelfood.com"
ADMIN_PASSWORD="Admin@Hostel2026"
ADMIN_NAME="Hostel Administrator"
