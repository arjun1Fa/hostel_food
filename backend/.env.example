PROJECT_NAME="Hostel Food Management"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Database: SQLite for local dev or PostgreSQL for production
# Local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./hostel_food.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://hostel_user:STRONG_SECURE_PASSWORD@db-host:5432/hostel_dining_prod"

# JWT & Security (DO NOT commit real secrets)
SECRET_KEY="replace_with_a_64_character_cryptographically_secure_random_secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="hostel-dining-api"
JWT_AUDIENCE="hostel-dining-client"

# Cookie Security & CSRF
COOKIE_SECURE=true
COOKIE_SAMESITE="lax"

# Allowed CORS Origins (comma separated in custom config or JSON array)
# CORS_ORIGINS='["https://dining.yourhostel.edu"]'

# Timezone & Reminders (Authoritative IST timezone)
TIMEZONE="Asia/Kolkata"
REMINDER_FIRST_HOUR=20
REMINDER_FIRST_MINUTE=0
REMINDER_FINAL_HOUR=22
REMINDER_FINAL_MINUTE=0

# Default Single Hostel (Phase 1)
DEFAULT_HOSTEL_NAME="Heritage Boys & Girls Hostel"
DEFAULT_HOSTEL_CODE="HERITAGE-01"

# Initial Admin Bootstrap (Change before initial deployment)
ADMIN_EMAIL="admin@hostelfood.com"
ADMIN_PASSWORD="CHANGE_ME_IN_PROD_Admin@Hostel2026"
ADMIN_NAME="Hostel Administrator"
